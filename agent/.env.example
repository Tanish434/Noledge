# =================================================================
# ASUNA 3D AVATAR CONFIGURATION (.env)
# =================================================================

# 1. LIVEKIT CLOUD (Required for WebRTC real-time connection)
# Sign up for free Build plan at https://cloud.livekit.io (50 GB free/mo, no card required)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxx

# Optional Secondary LiveKit Cloud Account (Multi-account fallback for STT & TTS inference)
LIVEKIT_URL_2=wss://your-second-project.livekit.cloud
LIVEKIT_API_KEY_2=APIxxxxxxxxx
LIVEKIT_API_SECRET_2=secretxxxxxxxxx

# 2. SPEECH-TO-TEXT (STT) - Groq Whisper Large v3 Turbo (Recommended, 100% FREE!)
# Sign up at https://console.groq.com (Instant free key, no card)
# Provides flagship multilingual accuracy (Hindi, English, Hinglish, accents, gaps & pauses)
GROQ_API_KEY=

# 3. FALLBACK STT: SPEECHMATICS (Speaker Diarization)
# Sign up at https://www.speechmatics.com ($100 free credit, ~100 hours free)
# Used automatically as fallback if GROQ_API_KEY is not set
SPEECHMATICS_API_KEY=

# 4. TEXT-TO-SPEECH (TTS) - Pick your voice engine:
# Option A: Cartesia Sonic-3 (Fast, low-latency, free credits at https://cartesia.ai)
CARTESIA_API_KEY=

# Option B: ElevenLabs Multilingual (Prestige human voice with breaths & emotion)
# Free 10,000 characters/mo at https://elevenlabs.io
ELEVEN_API_KEY=

# 5. LLM BRAIN
# Option A: OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# Option B: Google Gemini (100% FREE at https://aistudio.google.com)
GOOGLE_API_KEY=

# 6. LONG-TERM MEMORY (Mem0)
# Sign up for free Hobby tier at https://mem0.ai (10,000 add requests/mo free)
MEM0_API_KEY=

# 7. WEB SERVER PORT
PORT=5000
