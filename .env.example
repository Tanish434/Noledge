# Environment Variables Example for Noledge PWA
# Copy this file to .env.local and fill in your values.

# Base URL for Next.js app (defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — NEVER expose in frontend, server routes only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub OAuth App (Optional: for 1-click automatic GitHub authorization)
# Register a free OAuth App at: https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
